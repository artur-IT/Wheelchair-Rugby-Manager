{
  "name": "wheelchair-rugby-manager",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "node scripts/migrateOnBuild.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "dev:full": "concurrently \"pnpm run dev\" \"pnpm prisma studio\" \"pnpm run test:watch\"",
    "format": "prettier --write .",
    "db:clear": "node scripts/clearDb.mjs",
    "db:seed": "node scripts/seedDb.mjs",
    "db:reset-data": "pnpm run db:clear && pnpm run db:seed",
    "sync:st-prisma": "tsx scripts/sync_supertokens-prisma.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.7",
    "@astrojs/vercel": "^10.0.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/x-date-pickers": "^9.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.0",
    "argon2": "^0.44.0",
    "astro": "^6.4.7",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "supertokens-auth-react": "^0.51.2",
    "supertokens-node": "^24.0.2",
    "supertokens-web-js": "^0.16.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "8.61.1",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.7.0"
}
